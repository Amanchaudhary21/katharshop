# Copy this file to .env and fill it in. .env is not uploaded to GitHub.

# MySQL. The "shopnest" database and its tables are made the first time the server starts.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=shopnest

# The store owner (admin). Only these accounts can add, delete and restore products.
OWNER_EMAILS=amanecdy@gmail.com
# Password the owner types once on the Sell page ("Connect"). Empty = a new one is printed at every start.
OWNER_PASSWORD=choose-a-long-password

# Optional: port for the store (default 8080), and other web addresses allowed to call the API
# PORT=8080
# CORS_ORIGINS=https://amanchaudhary21.github.io
